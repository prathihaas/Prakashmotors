---
// N6 Masthead — utility strip over a square masthead bar.
// Dealer name leads; the New Holland relationship is carried as an endorsement
// line, which is how OEM guidelines treat authorised-dealer identity.
const nav = [
  { label: 'Tractors', href: '/#products' },
  { label: 'Service', href: '/service/' },
  { label: 'Locations', href: '/locations/armoor/' },
  { label: 'Guides', href: '/blog/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
const PHONE_DISPLAY = '90308 57333';
const PHONE_HREF = 'tel:+919030857333';
---

<header class="sticky top-0 z-40">
  <!-- Utility strip -->
  <div class="bg-nh-navy text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-9 flex items-center justify-between gap-4">
      <p class="text-[11px] font-bold uppercase tracking-eyebrow text-nh-yellow truncate">
        Authorised New Holland Agriculture Dealer
      </p>
      <p class="hidden sm:block text-[11px] font-bold uppercase tracking-eyebrow text-white/80 whitespace-nowrap">
        Nizamabad · Kamareddy · Armoor · Bodhan · Banswada
      </p>
    </div>
  </div>

  <!-- Masthead -->
  <div class="bg-white border-b-2 border-nh-navy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 lg:h-20 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2.5 min-w-0 group" aria-label="Prakash Motors Nizamabad — home">
        <span class="w-1.5 self-stretch shrink-0 bg-nh-yellow" aria-hidden="true"></span>
        <span class="flex flex-col leading-none py-1 min-w-0">
          <span class="font-display text-base sm:text-lg lg:text-xl font-black uppercase tracking-tight text-nh-navy whitespace-nowrap">
            Prakash Motors
          </span>
          <span class="mt-1 hidden sm:block text-[10px] font-bold uppercase tracking-eyebrow text-muted whitespace-nowrap">
            Tractors &amp; Harvesters
          </span>
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-6" aria-label="Primary">
        {nav.map((item) => (
          <a
            href={item.href}
            class="relative py-2 text-xs font-bold uppercase tracking-button text-nh-navy transition-colors duration-150 ease-out hover:text-nh-blue after:absolute after:left-0 after:right-0 after:-bottom-0.5 after:h-[3px] after:bg-nh-yellow after:scale-x-0 after:origin-left after:transition-transform after:duration-150 hover:after:scale-x-100"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a href={PHONE_HREF} class="nh-btn nh-btn--navy hidden sm:inline-flex">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2.1Z"/></svg>
          {PHONE_DISPLAY}
        </a>

        <!-- Mobile disclosure: no JS, no layout shift -->
        <details class="lg:hidden group">
          <summary
            class="nh-btn nh-btn--ghost list-none cursor-pointer [&::-webkit-details-marker]:hidden"
            aria-label="Open menu"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true" class="group-open:hidden"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true" class="hidden group-open:block"><path d="M5 5l14 14M19 5L5 19"/></svg>
            <span class="sr-only">Menu</span>
          </summary>
          <div class="absolute left-0 right-0 top-full bg-white border-b-2 border-nh-navy shadow-xl">
            <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-2" aria-label="Mobile">
              {nav.map((item) => (
                <a
                  href={item.href}
                  class="block py-3 border-b border-rule last:border-0 text-sm font-bold uppercase tracking-button text-nh-navy hover:text-nh-blue"
                >
                  {item.label}
                </a>
              ))}
              <a href={PHONE_HREF} class="nh-btn w-full my-3">Call {PHONE_DISPLAY}</a>
            </nav>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
