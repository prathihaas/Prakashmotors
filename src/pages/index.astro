---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Fetch Data
const allProducts = await getCollection('products');
const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft);
const allBlogCount = allBlogPosts.length;
const recentPosts = allBlogPosts
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 3);

const WA_BASE = 'https://wa.me/919030857333';
const PHONE_HREF = 'tel:+919030857333';
const PHONE_DISPLAY = '90308 57333';

// Figures already published on this site — not new claims.
const atAGlance = [
  { value: 'Since 2003', label: 'Authorised dealer', label_te: 'అధీకృత డీలర్' },
  { value: '2,000+', label: 'Farmers served', label_te: 'రైతులు' },
  { value: '4.7 / 5', label: '148 Google reviews', label_te: 'గూగుల్ రివ్యూలు' },
  { value: '4', label: 'Districts covered', label_te: 'జిల్లాలు' },
];

const coverage = [
  { label: 'Armoor', href: '/locations/armoor/' },
  { label: 'Bodhan', href: '/locations/bodhan/' },
  { label: 'Banswada', href: '/locations/banswada/' },
  { label: 'Kamareddy', href: '/locations/kamareddy/' },
];

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Store",
      "@id": "https://www.prakashmotors.in/#organization",
      "additionalType": "https://schema.org/AutoDealer",
      "name": "Prakash Motors",
      "url": "https://www.prakashmotors.in",
      "telephone": "+91-9030857333",
      "foundingDate": "2003",
      "image": "https://www.prakashmotors.in/og-image.jpg",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.prakashmotors.in/favicon.jpg"
      },
      "brand": { "@type": "Brand", "name": "New Holland Agriculture" },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Opposite New Bus Stand",
        "addressLocality": "Nizamabad",
        "addressRegion": "Telangana",
        "postalCode": "503001",
        "addressCountry": "IN"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": 18.6725, "longitude": 78.0941 },
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
        "opens": "09:00",
        "closes": "19:00"
      }],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.7",
        "reviewCount": "148",
        "bestRating": "5",
        "worstRating": "1"
      },
      "priceRange": "₹₹₹",
      "areaServed": ["Nizamabad", "Kamareddy", "Armoor", "Bodhan", "Banswada", "Yellareddy", "Balkonda", "Bheemgal", "Telangana"],
      "sameAs": [
        "https://www.facebook.com/prakashmotors",
        "https://www.instagram.com/prakashmotors"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Which New Holland tractors are available at Prakash Motors Nizamabad?",
          "acceptedAnswer": { "@type": "Answer", "text": "Prakash Motors stocks New Holland 3230, 3630 TX Super Plus, 3630 TX Special Edition, 3600-2 Excel, Excel 4510, Excel 4710, Excel Ultima 5510, Workmaster 105, and combine harvesters. Visit our showroom opposite New Bus Stand, Nizamabad or call 9030857333." }
        },
        {
          "@type": "Question",
          "name": "What is the price of New Holland 3630 tractor in Nizamabad?",
          "acceptedAnswer": { "@type": "Answer", "text": "The New Holland 3630 TX Super Plus is priced between ₹8.5–10 lakh ex-showroom in Nizamabad. EMI options start from ₹14,000/month. Call Prakash Motors on 9030857333 for today's offer price and financing." }
        },
        {
          "@type": "Question",
          "name": "Is Prakash Motors an authorized New Holland dealer?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Prakash Motors is an authorized New Holland Agriculture dealer in Nizamabad, Telangana, serving Nizamabad, Kamareddy, Armoor, Bodhan and Banswada since 2003." }
        },
        {
          "@type": "Question",
          "name": "Does Prakash Motors offer tractor EMI or loan?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Prakash Motors offers tractor financing through leading banks with up to 7-year loan tenure. WhatsApp us on 9030857333 for EMI calculation on any New Holland model." }
        }
      ]
    }
  ]
};
---

<Layout title="New Holland Tractors Nizamabad | Best Price ☎ 9030857333" description="Prakash Motors — Nizamabad's #1 New Holland dealer. Tractors, harvesters & farm equipment at best price. EMI from ₹3,999/mo. Call +91 9030857333." noOrgSchema={true}>

    <main>
    <!-- ============================================================
         HERO — Workbench: a statement, the credentials, and the machine.
         ============================================================ -->
    <section class="border-b border-rule bg-paper2">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
            <div class="grid lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] gap-10 lg:gap-16 items-center">
                <div>
                    <p class="nh-eyebrow">Authorised New Holland dealer · Nizamabad</p>

                    <h1 class="mt-5 font-display font-black uppercase text-nh-navy leading-[1.04] tracking-tight text-[clamp(2.25rem,5.2vw,4rem)]">
                        New Holland tractors<br />and harvesters,<br />
                        <span class="text-nh-blue">bought and serviced in Nizamabad</span>
                    </h1>

                    <p class="mt-4 font-telugu text-lg sm:text-xl font-bold text-muted">
                        వ్యవసాయంలో మీ విజయ ప్రస్థానం
                    </p>

                    <div class="mt-6 max-w-xl space-y-1">
                        <span class="mb-4 block h-[3px] w-16 bg-nh-yellow" aria-hidden="true"></span>
                        <p class="text-base sm:text-lg text-muted">
                            Full New Holland range, genuine parts and a workshop that stays with the machine —
                            from the showroom opposite New Bus Stand.
                        </p>
                        <p class="font-telugu text-base text-muted">
                            నిజామాబాద్‌లో అత్యుత్తమ ట్రాక్టర్లు మరియు హార్వెస్టర్ల కోసం.
                        </p>
                    </div>

                    <div class="mt-8 flex flex-col sm:flex-row gap-3">
                        <a
                            href={`${WA_BASE}?text=${encodeURIComponent('Hi, I want to know the price of New Holland tractor in Nizamabad. [W-HP]')}`}
                            target="_blank" rel="noopener noreferrer" class="nh-btn nh-btn--wa">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.5 14c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.1-1.8-.1a13 13 0 0 1-5.7-4.6c-.4-.6-1-1.5-1-2.9s.7-2 1-2.3a1 1 0 0 1 .7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2 0 .4-.1.6l-.4.5c-.1.2-.3.3-.1.6a9.4 9.4 0 0 0 3.7 3c.3.2.5.1.6 0l.8-1c.2-.2.3-.2.6-.1l1.9.9c.3.1.5.2.5.4v.9Z"/></svg>
                            Get price list
                        </a>
                        <a href={PHONE_HREF} class="nh-btn nh-btn--ghost">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2.1Z"/></svg>
                            Call {PHONE_DISPLAY}
                        </a>
                    </div>
                </div>

                <figure class="relative">
                    <img
                        src="/images/hero.jpg"
                        alt="New Holland tractor at Prakash Motors, the authorised New Holland dealer in Nizamabad"
                        class="w-full aspect-[4/3] object-cover"
                        width="960" height="720"
                        fetchpriority="high" loading="eager" decoding="async" />
                    <figcaption class="absolute left-0 bottom-0 bg-nh-navy text-white px-4 py-3 max-w-[85%]">
                        <span class="block text-[10px] font-bold uppercase tracking-eyebrow text-nh-yellow">Showroom</span>
                        <span class="block text-sm font-bold">Opposite New Bus Stand, Nizamabad</span>
                    </figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- ============================================================
         AT A GLANCE — the spec strip
         ============================================================ -->
    <section class="bg-nh-navy text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <dl class="grid grid-cols-2 lg:grid-cols-4 divide-y divide-white/15 lg:divide-y-0 lg:divide-x lg:divide-white/15">
                {atAGlance.map((item) => (
                    <div class="py-6 lg:py-8 lg:px-8 first:lg:pl-0 last:lg:pr-0 odd:pr-4 even:pl-4 lg:odd:pr-8 lg:even:pl-8">
                        <dt class="sr-only">{item.label}</dt>
                        <dd>
                            <span class="block font-display text-2xl sm:text-3xl font-black text-nh-yellow leading-none">{item.value}</span>
                            <span class="mt-2 block text-[11px] font-bold uppercase tracking-eyebrow text-white/70">{item.label}</span>
                            <span class="mt-0.5 block font-telugu text-xs text-white/50">{item.label_te}</span>
                        </dd>
                    </div>
                ))}
            </dl>
        </div>
    </section>

    <!-- ============================================================
         MODEL INDEX — Workbench rows, not a card grid.
         ============================================================ -->
    <section id="products" class="py-16 lg:py-24 bg-paper">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="nh-eyebrow">Model index</p>
            <h2 class="mt-4 font-display text-[clamp(1.75rem,3.4vw,2.75rem)] font-black uppercase text-nh-navy leading-tight max-w-3xl">
                New Holland tractors &amp; harvesters in stock
            </h2>
            <p class="mt-2 font-telugu text-lg text-muted">మా వద్ద లభించు ఆధునిక యంత్రాలు</p>

            <ul class="mt-10 border-t-2 border-nh-navy">
                {allProducts.map((product) => (
                    <li class="group border-b border-rule">
                        <div class="grid gap-6 py-7 md:grid-cols-[minmax(0,220px)_minmax(0,1fr)_minmax(0,260px)] md:items-start">
                            <a href={`/products/${product.slug}`} class="block overflow-hidden bg-paper2 aspect-[4/3] md:aspect-[4/3]">
                                <img
                                    src={product.data.image}
                                    alt={`New Holland ${product.data.title} at Prakash Motors Nizamabad`}
                                    class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                                    loading="lazy" decoding="async" />
                            </a>

                            <div class="min-w-0">
                                {product.data.isRecommended && (
                                    <span class="inline-block mb-2 bg-nh-yellow text-nh-navyInk text-[10px] font-black uppercase tracking-eyebrow px-2 py-1">
                                        Most asked for
                                    </span>
                                )}
                                <h3 class="font-display text-xl sm:text-2xl font-black uppercase text-nh-navy leading-tight">
                                    <a href={`/products/${product.slug}`} class="hover:text-nh-blue transition-colors duration-150">
                                        {product.data.title}
                                    </a>
                                </h3>
                                <p class="mt-1 font-telugu text-base font-bold text-muted">{product.data.title_te}</p>

                                <ul class="mt-4 grid sm:grid-cols-2 gap-x-6 gap-y-1.5">
                                    {product.data.features.map((feature) => (
                                        <li class="flex gap-2 text-sm text-muted">
                                            <span class="mt-[7px] h-[3px] w-3 shrink-0 bg-nh-yellow" aria-hidden="true"></span>
                                            <span class="min-w-0">{feature}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>

                            <div class="flex flex-col gap-2 md:items-stretch">
                                <a
                                    href={product.data.whatsapp_message || `${WA_BASE}?text=${encodeURIComponent('Hi, I want a price quote for a New Holland tractor. [W-PM]')}`}
                                    target="_blank" rel="noopener noreferrer"
                                    class="nh-btn nh-btn--navy w-full">
                                    Ask price
                                </a>
                                <a href={`/products/${product.slug}`} class="nh-btn nh-btn--ghost w-full">
                                    Full specification
                                </a>
                            </div>
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- ============================================================
         SERVICE — navy workbench slab
         ============================================================ -->
    <section class="bg-nh-navy text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
            <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
                <div>
                    <p class="nh-eyebrow !text-nh-yellow">Workshop</p>
                    <h2 class="mt-4 font-display text-[clamp(1.75rem,3.4vw,2.75rem)] font-black uppercase leading-tight">
                        A tractor is only as good as the workshop behind it
                    </h2>
                    <p class="mt-4 text-white/75 max-w-xl leading-relaxed">
                        Genuine New Holland parts, trained technicians and field support across Nizamabad,
                        Kamareddy, Armoor, Bodhan and Banswada.
                    </p>
                    <div class="mt-8 flex flex-col sm:flex-row gap-3">
                        <a href="/service/" class="nh-btn">Service &amp; AMC</a>
                        <a
                            href={`${WA_BASE}?text=${encodeURIComponent('Hi, I want to book a service for my New Holland tractor. [W-SVC]')}`}
                            target="_blank" rel="noopener noreferrer"
                            class="nh-btn nh-btn--wa">
                            Book on WhatsApp
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[11px] font-bold uppercase tracking-eyebrow text-nh-yellow">Coverage</p>
                    <ul class="mt-4 border-t border-white/20">
                        {coverage.map((c) => (
                            <li class="border-b border-white/20">
                                <a href={c.href} class="flex items-center justify-between gap-4 py-4 group/link">
                                    <span class="font-display text-lg font-bold uppercase tracking-wide">{c.label}</span>
                                    <span class="text-nh-yellow transition-transform duration-150 ease-out group-hover/link:translate-x-1" aria-hidden="true">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ul>
                    <p class="mt-4 text-xs text-white/50">Sales and service also available at the Nizamabad main showroom.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
         GUIDES — editorial list
         ============================================================ -->
    <section id="blog" class="py-16 lg:py-24 bg-paper2">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
                <div>
                    <p class="nh-eyebrow">Field notes</p>
                    <h2 class="mt-4 font-display text-[clamp(1.75rem,3.4vw,2.75rem)] font-black uppercase text-nh-navy leading-tight">
                        Buying guides &amp; farming tips
                    </h2>
                    <p class="mt-2 font-telugu text-lg text-muted">వ్యవసాయ విశేషాలు మరియు చిట్కాలు</p>
                </div>
                <a href="/blog/" class="nh-btn nh-btn--ghost self-start sm:self-auto">
                    All {allBlogCount} guides
                </a>
            </div>

            <ul class="mt-10 border-t-2 border-nh-navy">
                {recentPosts.map((post) => (
                    <li class="border-b border-rule">
                        <a href={`/blog/${post.slug}/`} class="group grid gap-5 py-7 sm:grid-cols-[minmax(0,180px)_minmax(0,1fr)] items-start">
                            <div class="overflow-hidden bg-paper3 aspect-[16/10]">
                                <img
                                    src={post.data.featured_image || '/images/hero.jpg'}
                                    alt=""
                                    class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                                    loading="lazy" decoding="async" />
                            </div>
                            <div class="min-w-0">
                                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-bold uppercase tracking-eyebrow">
                                    <span class="text-nh-blue">{post.data.category}</span>
                                    <span class="text-muted2">
                                        {post.data.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                                    </span>
                                </p>
                                <h3 class="mt-2 font-display text-lg sm:text-xl font-bold text-nh-navy leading-snug group-hover:text-nh-blue transition-colors duration-150">
                                    {post.data.title}
                                </h3>
                                <p class="mt-1 font-telugu text-base font-semibold text-muted">{post.data.title_te}</p>
                                <p class="mt-2 text-sm text-muted line-clamp-2">{post.data.excerpt}</p>
                            </div>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- ============================================================
         VISIT
         ============================================================ -->
    <section id="contact" class="py-16 lg:py-24 bg-paper">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="nh-eyebrow">Visit</p>
            <h2 class="mt-4 font-display text-[clamp(1.75rem,3.4vw,2.75rem)] font-black uppercase text-nh-navy leading-tight">
                Come and see the machine
            </h2>
            <p class="mt-2 font-telugu text-lg text-muted">ప్రకాష్ మోటార్స్ సందర్శించండి</p>
            <p class="mt-3 text-muted">Opposite New Bus Stand, Nizamabad, Telangana 503001 · Mon–Sat, 9 AM – 7 PM</p>

            <div class="mt-10 grid gap-px bg-rule sm:grid-cols-3 border border-rule">
                <a href={PHONE_HREF} class="group bg-paper p-7 transition-colors duration-150 ease-out hover:bg-paper2">
                    <span class="text-[11px] font-bold uppercase tracking-eyebrow text-muted2">Call</span>
                    <span class="mt-2 block font-display text-xl font-black text-nh-navy">{PHONE_DISPLAY}</span>
                    <span class="mt-3 inline-block h-[3px] w-8 bg-nh-yellow transition-all duration-150 ease-out group-hover:w-14" aria-hidden="true"></span>
                </a>
                <a href="https://share.google/YC7Yg9tpaUSP7iB8w" target="_blank" rel="noopener noreferrer" class="group bg-paper p-7 transition-colors duration-150 ease-out hover:bg-paper2">
                    <span class="text-[11px] font-bold uppercase tracking-eyebrow text-muted2">Directions</span>
                    <span class="mt-2 block font-display text-xl font-black text-nh-navy">Google Maps</span>
                    <span class="mt-3 inline-block h-[3px] w-8 bg-nh-yellow transition-all duration-150 ease-out group-hover:w-14" aria-hidden="true"></span>
                </a>
                <a
                    href={`${WA_BASE}?text=${encodeURIComponent('Hi, I want to contact Prakash Motors, Nizamabad. [W-PM]')}`}
                    target="_blank" rel="noopener noreferrer"
                    class="group bg-nh-navy p-7 transition-colors duration-150 ease-out hover:bg-nh-navyDeep">
                    <span class="text-[11px] font-bold uppercase tracking-eyebrow text-nh-yellow">Message</span>
                    <span class="mt-2 block font-display text-xl font-black text-white">WhatsApp</span>
                    <span class="mt-3 inline-block h-[3px] w-8 bg-nh-yellow transition-all duration-150 ease-out group-hover:w-14" aria-hidden="true"></span>
                </a>
            </div>

            <div class="mt-8 flex flex-col sm:flex-row gap-3">
                <a href="https://g.page/r/CU6CrRar3bvuEBM/review" target="_blank" rel="noopener noreferrer" class="nh-btn nh-btn--ghost">
                    Read Google reviews
                </a>
                <a href="https://g.page/r/CU6CrRar3bvuEBM/review" target="_blank" rel="noopener noreferrer" class="nh-btn">
                    Write a review
                </a>
            </div>
        </div>
    </section>

    </main>

    <!-- Desktop WhatsApp anchor (square, brand-consistent) -->
    <a
        href={`${WA_BASE}?text=${encodeURIComponent('Hi, I want to know about New Holland tractors and harvesters. [W-PM]')}`}
        target="_blank" rel="noopener noreferrer"
        class="hidden sm:flex fixed bottom-6 right-6 z-50 items-center gap-3 bg-wa text-white px-5 py-3 shadow-lg transition-colors duration-150 ease-out hover:bg-waDeep">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.5 14c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.1-1.8-.1a13 13 0 0 1-5.7-4.6c-.4-.6-1-1.5-1-2.9s.7-2 1-2.3a1 1 0 0 1 .7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2 0 .4-.1.6l-.4.5c-.1.2-.3.3-.1.6a9.4 9.4 0 0 0 3.7 3c.3.2.5.1.6 0l.8-1c.2-.2.3-.2.6-.1l1.9.9c.3.1.5.2.5.4v.9Z"/></svg>
        <span class="flex flex-col text-left leading-tight">
            <span class="text-[10px] font-bold uppercase tracking-eyebrow opacity-90">Chat with us</span>
            <span class="text-sm font-black">Get price list</span>
        </span>
    </a>

    <!-- Mobile action bar -->
    <div class="sm:hidden fixed bottom-0 left-0 right-0 z-50 grid grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] border-t-2 border-nh-navy bg-white">
        <a href={PHONE_HREF} class="nh-btn nh-btn--navy !border-0 h-14">Call</a>
        <a
            href={`${WA_BASE}?text=${encodeURIComponent('Hi, I want to know the price of New Holland tractor in Nizamabad. [W-HP-BAR]')}`}
            target="_blank" rel="noopener noreferrer"
            class="nh-btn nh-btn--wa !border-0 h-14">
            WhatsApp price
        </a>
    </div>
    <div class="h-14 sm:hidden" aria-hidden="true"></div>

    <!-- FAQ + LocalBusiness Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
</Layout>
