---
import SEOHead from '../components/SEOHead.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogType?: string;
  noOrgSchema?: boolean;
}

const {
  title,
  description = "Prakash Motors — Nizamabad's #1 New Holland dealer. Best price on 3630 TX, 3600-2 Tractors, Sugarcane & Silver Track Harvesters. EMI available. Free demo. ☎ +91 9030857333.",
  canonical,
  image = "/og-image.jpg",
  ogType,
  noOrgSchema = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />
    <meta name="theme-color" content="#001489" />
    <SEOHead title={title} description={description} canonical={canonical} image={image} ogType={ogType} noOrgSchema={noOrgSchema} />
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MCMZWFT3');</script>
    <!-- End Google Tag Manager -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Telugu:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js"></script>
    <style>
      .font-telugu { font-family: 'Noto Sans Telugu', sans-serif; }
      @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
      .animate-float { animation: float 3s ease-in-out infinite; }

      /* Decorative elements: hint the cursor that they aren't tappable */
      .no-tap, .no-tap * { pointer-events: none; user-select: none; }

      /* Blog: stop <strong> from looking like a link (was causing dead clicks) */
      article.prose strong, .prose strong { color: #0B1437; font-weight: 800; }
      article.prose strong:not(a strong), .prose strong:not(a strong) {
        cursor: text; background: linear-gradient(transparent 60%, rgba(255,209,0,.35) 60%);
        padding: 0 2px; border-radius: 2px;
      }

      /* Toast for desktop tel: fallback */
      #tel-toast {
        position: fixed; left: 50%; bottom: 96px;
        transform: translateX(-50%) translateY(20px);
        background: #0B1437; color: #FFD100;
        padding: 12px 18px; border-radius: 12px;
        font-size: 14px; font-weight: 700;
        opacity: 0; transition: opacity .2s ease, transform .2s ease;
        z-index: 9999; pointer-events: none;
        box-shadow: 0 12px 30px -8px rgba(0,0,0,.4);
      }
      #tel-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    </style>
  </head>
  <body class="bg-white text-gray-900 min-h-screen flex flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MCMZWFT3"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />

    <!-- Global desktop tel: fallback (copies number on desktop browsers without dialler) -->
    <div id="tel-toast" role="status" aria-live="polite"></div>
    <script>
      (function () {
        var toast = document.getElementById('tel-toast');
        var t;
        function show(msg) {
          if (!toast) return;
          toast.textContent = msg;
          toast.classList.add('show');
          clearTimeout(t);
          t = setTimeout(function () { toast.classList.remove('show'); }, 3000);
        }
        var isMobile = /Mobi|Android|iPhone|iPad|iPod|Windows Phone/i.test(navigator.userAgent);
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest && e.target.closest('a[href^="tel:"]');
          if (!a) return;
          if (isMobile) return;
          e.preventDefault();
          var num = a.getAttribute('href').replace('tel:', '').replace(/\s+/g, '');
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(num);
              show('📞 Number copied: ' + num);
            } else {
              show('📞 Call us: ' + num);
            }
          } catch (err) {
            show('📞 Call us: ' + num);
          }
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'tel_click_desktop', phone: num });
        }, false);
      })();
    </script>
      <!-- Lead source tracking: stamps WhatsApp links with traffic source (Google Ads vs Organic). Astro needs is:inline. -->
    <script is:inline>
    (function () {
      try {
        var LS = window.localStorage;
        var qp = new URLSearchParams(location.search);
        function classify() {
          if (LS.getItem('lead_src')) return; // first-touch only
          var gclid = qp.get('gclid') || qp.get('gbraid') || qp.get('wbraid');
          var gad = qp.get('gad_source') || qp.get('gclsrc');
          var um = (qp.get('utm_medium') || '').toLowerCase();
          var us = (qp.get('utm_source') || '').toLowerCase();
          var src = null, g = null;
          if (gclid || gad || um === 'cpc' || um === 'ppc' || um === 'paid') {
            src = 'gads'; if (gclid) g = gclid.slice(0, 24);
          } else if (us === 'google') {
            src = 'org_google';
          } else if (us) {
            src = 'utm_' + us.replace(/[^a-z0-9_]/g, '').slice(0, 16);
          } else {
            var ref = document.referrer || '';
            if (/[.\/]google\./i.test(ref)) src = 'org_google';
            else if (/bing\.|duckduckgo|yahoo\./i.test(ref)) src = 'org_search';
            else if (/facebook|instagram|fb\.|t\.co|twitter|x\.com/i.test(ref)) src = 'social';
            else if (ref && ref.indexOf(location.hostname) === -1) src = 'ref';
            else src = 'direct';
          }
          LS.setItem('lead_src', src);
          if (g) LS.setItem('lead_gclid', g);
          LS.setItem('lead_lp', (location.pathname || '/').slice(0, 40));
        }
        function tagLinks() {
          var s = LS.getItem('lead_src') || 'direct';
          var g = LS.getItem('lead_gclid');
          var tag = ' [wsrc:' + s + (g ? ('|g:' + g) : '') + ']';
          var links = document.querySelectorAll('a[href*="wa.me"], a[href*="api.whatsapp"]');
          for (var i = 0; i < links.length; i++) {
            var a = links[i];
            if (a.getAttribute('data-wsrc')) continue;
            var href = a.getAttribute('href'); if (!href) continue;
            if (href.indexOf('text=') > -1) {
              href = href.replace(/([?&])text=([^&#]*)/, function (m, p, txt) { return p + 'text=' + txt + encodeURIComponent(tag); });
            } else {
              href += (href.indexOf('?') > -1 ? '&' : '?') + 'text=' + encodeURIComponent('Hi' + tag);
            }
            a.setAttribute('href', href);
            a.setAttribute('data-wsrc', '1');
          }
        }
        classify();
        tagLinks();
        document.addEventListener('click', tagLinks, true);   // catch links added after load
        window.addEventListener('load', tagLinks);
      } catch (e) {}
    })();
    </script>

  </body>
</html>
